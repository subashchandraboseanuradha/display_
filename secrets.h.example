#pragma once

// ── Saved WiFi networks (up to 3) ────────────────────────────────────────────
// Device scans nearby networks and auto-connects to whichever is in range.
// Fill in your credentials and reflash. Leave SSID_3 empty if unused.
#define WIFI_SSID_1    "YourHomeNetwork"
#define WIFI_PASS_1    "yourpassword"

#define WIFI_SSID_2    "YourHotspot"   // e.g. mobile hotspot
#define WIFI_PASS_2    "yourpassword"

#define WIFI_SSID_3    ""
#define WIFI_PASS_3    ""

// Legacy aliases used by existing code
#define WIFI_SSID      WIFI_SSID_1
#define WIFI_PASS      WIFI_PASS_1

// ── Deepgram ──────────────────────────────────────────────────────────────────
// Get a free API key at https://deepgram.com
#define DEEPGRAM_API_KEY "your_deepgram_api_key_here"

// ── OpenRouter (AI Ask feature) ───────────────────────────────────────────────
// Get a free key at https://openrouter.ai
#define OPENROUTER_API_KEY "your_openrouter_api_key_here"

// ── Merriam-Webster Learner's Dictionary (real definitions for /dict) ─────────
// Get a free key at https://dictionaryapi.com — free tier, 1000 req/day.
#define MERRIAM_WEBSTER_API_KEY "your_merriam_webster_api_key_here"

// ── Merriam-Webster Collegiate Dictionary (fallback when Learner's misses) ────
#define MERRIAM_WEBSTER_COLLEGIATE_API_KEY "your_merriam_webster_collegiate_api_key_here"

// ── Telegram (mobile sync for notes + photos) ──────────────────────────────────
// Message @BotFather -> /newbot for the token. Message @userinfobot (or your
// bot after /start) to get your numeric chat ID.
#define TELEGRAM_BOT_TOKEN "your_telegram_bot_token_here"
#define TELEGRAM_CHAT_ID   "your_telegram_chat_id_here"
